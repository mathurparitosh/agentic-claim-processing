# Local environment variables for claim assistant

# Claim-processing graph switch -- "orchestrator" (default, Research/Decisioning
# sub-agents, specs/technical.md §5) or "legacy" (the original single-agent ReAct
# loop). See backend/worker.py.
AGENT_MODE=orchestrator

# Agent LLM provider switch -- "openai" (default), "openrouter", or "ollama".
# See backend/agent/llm.py.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Only needed if LLM_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys.
# openrouter/free auto-routes to a free, tool-calling-capable model; free tier is
# rate-limited (50 req/day with no credit ever purchased, 20 req/min).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Only used if LLM_PROVIDER=ollama -- a local Ollama server, no key, no cost, offline.
# The claim loop needs reliable tool-calling under a long system prompt. Observed with
# a local Ollama install:
#   gemma3:4b    Ollama rejects it ("does not support tools")
#   llama3.1:8b  tool-calls in isolation, but narrates the tool call instead of emitting
#                it under the real research prompt -> run ends inconclusive
#   qwen2.5:14b  works for full claim runs (`ollama pull qwen2.5:14b`)
# Ollama also does not enforce tool_choice="required", so weaker models drift to prose.
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_BASE_URL=http://localhost:11434/v1
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=claims-policy-corpus
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.langsmith.com
LANGSMITH_PROJECT=claim-assistant
DATABASE_URL=postgresql://postgres:password@localhost:5432/claims_dev
AUTH_PASSWORD=password