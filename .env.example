# Local environment variables for claim assistant

# Agent LLM provider switch -- "openai" (default) or "openrouter". See backend/agent/llm.py.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# Only needed if LLM_PROVIDER=openrouter. Get a key at https://openrouter.ai/keys.
# openrouter/free auto-routes to a free, tool-calling-capable model; free tier is
# rate-limited (50 req/day with no credit ever purchased, 20 req/min).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=claims-policy-corpus
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.langsmith.com
LANGSMITH_PROJECT=claim-assistant
DATABASE_URL=postgresql://postgres:password@localhost:5432/claims_dev
AUTH_PASSWORD=super-secret-password